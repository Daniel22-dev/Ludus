{
  "schema": "ghrab-data-manifest-v1",
  "appId": "ludus",
  "appVersion": "1.16.19",
  "manifestVersion": 5,
  "dataCategories": [
    "settings",
    "application-content",
    "diagnostics",
    "ai-prompts-and-results"
  ],
  "privacy": {
    "studentContentMayOccur": true,
    "telemetryContainsContent": false,
    "diagnosticsContainContentByDefault": false,
    "pseudonymisationIsNotAnonymisation": true
  },
  "stores": [
    {
      "kind": "localStorage",
      "category": "application-data",
      "patterns": [
        "ghrab.ludus.*",
        "ludus_*",
        "ludus.*",
        "chronos_*",
        "jumanji_*",
        "hga_v2",
        "laughworks_save_v1",
        "kostka_osudu_save_v1",
        "lotr_quest_v1",
        "relic_hunter_*",
        "hvezdni_rytiri_*"
      ],
      "excludePatterns": [
        "ghrab.ludus.suite-session-seen.v1",
        "ghrab.ludus.suite-session-status.v1",
        "ghrab.ludus.migration.p2-storage-namespace-v1.done"
      ],
      "sensitivity": "potentially-personal",
      "authority": "client",
      "clearOnEndWork": true,
      "purpose": "Builder settings and all legacy/canonical LUDUS content namespaces. Platform migration backup remains in scope and is deleted because it may contain the same sensitive legacy values."
    },
    {
      "kind": "sessionStorage",
      "category": "session-data",
      "patterns": [
        "ghrab.ludus.*",
        "ludus_*",
        "ludus.*",
        "chronos_*",
        "jumanji_*",
        "hga_v2",
        "laughworks_save_v1",
        "kostka_osudu_save_v1",
        "lotr_quest_v1",
        "relic_hunter_*",
        "hvezdni_rytiri_*",
        "ludusTeacherMode"
      ],
      "excludePatterns": [
        "ghrab.ludus.suite-session-tab-seen.v1"
      ],
      "sensitivity": "confidential",
      "authority": "client",
      "clearOnEndWork": true,
      "purpose": "Tab-scoped engine identity/progress, uploaded engine images and session UI state."
    },
    {
      "kind": "localStorage",
      "category": "credential",
      "patterns": [
        "ludus_gemini_key",
        "ghrab.ludus.gemini_key"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true,
      "purpose": "Legacy persistent Gemini key is migration/cleanup-only; current UI moves it to session and removes the persistent copy."
    },
    {
      "kind": "sessionStorage",
      "category": "credential",
      "patterns": [
        "ludus_gemini_key_session",
        "ghrab.ludus.gemini_key_session"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true,
      "purpose": "Session-only Gemini credential used for direct provider mode."
    },
    {
      "kind": "localStorage",
      "category": "nonpersonal-settings",
      "patterns": [
        "ghrab-manual-progress-ludus-*",
        "ghrab-manual-theme"
      ],
      "sensitivity": "non-content-settings",
      "authority": "client",
      "clearOnEndWork": false,
      "purpose": "Interactive manual completion state and theme; contains no student/work content."
    },
    {
      "kind": "localStorage",
      "category": "security-lifecycle-control",
      "patterns": [
        "ghrab.ludus.suite-session-seen.v1",
        "ghrab.ludus.suite-session-status.v1",
        "ghrab.ludus.migration.p2-storage-namespace-v1.done"
      ],
      "sensitivity": "security-metadata",
      "authority": "platform-or-child-as-declared",
      "clearOnEndWork": false,
      "purpose": "Platform ACK, child audit status and storage migration tombstone required to make replay/idempotency safe."
    },
    {
      "kind": "sessionStorage",
      "category": "security-lifecycle-control",
      "patterns": [
        "ghrab.ludus.suite-session-tab-seen.v1"
      ],
      "sensitivity": "security-metadata",
      "authority": "child",
      "clearOnEndWork": false,
      "purpose": "Per-browsing-context generation baseline used to catch suspended/BFCache/multi-tab contexts after suite end."
    },
    {
      "kind": "cacheStorage",
      "category": "application-cache",
      "patterns": [
        "ghrab-ludus-v*",
        "ludus*"
      ],
      "sensitivity": "non-content-cache",
      "authority": "client",
      "clearOnEndWork": false
    }
  ],
  "retention": {
    "defaultDays": 30,
    "sessionEndsOnLogout": true,
    "serverLogsDays": 30
  },
  "export": {
    "supported": true,
    "requiresExplicitUserAction": true,
    "includesSecrets": false,
    "envelopeSchema": "ghrab-artifact-envelope-v1",
    "artifactTypes": [],
    "nativeFormats": [
      "html",
      "json"
    ]
  },
  "deletion": {
    "supported": true,
    "clientVerified": true,
    "control": "LUDUSPrivacy.endWork()",
    "suiteControl": "LUDUSPrivacy.handleSuiteSessionEnd()",
    "acknowledgeOnlyAfterVerifiedCleanup": true
  },
  "sharedDevice": {
    "supported": true,
    "defaultInSchoolProfile": true,
    "control": "LUDUSPrivacy.endWork()",
    "suiteSessionContract": "ghrab-suite-session-v1",
    "isolation": "engine player identity/progress is tab/session scoped; legacy persistent engine keys are scrubbed before engine execution",
    "simultaneousTabs": "per-tab suite generation baseline plus write quarantine prevents stale tabs/BFCache from restoring old content",
    "replay": "platform pending replay plus child pageshow/focus/storage reconciliation",
    "failClosed": true
  },
  "storageNamespace": {
    "schema": "ghrab-storage-namespace-v1",
    "prefix": "ghrab.ludus.",
    "migrationId": "p2-storage-namespace-v1",
    "backup": "full",
    "rollbackSupported": true
  },
  "import": {
    "supported": true,
    "artifactTypes": [
      "studio-material",
      "ludus-content"
    ],
    "acceptsLegacyJson": true,
    "checksumRequiredForEnvelope": true
  },
  "sessionLifecycle": {
    "contract": "ghrab-suite-session-v1",
    "generationKey": "ghrab.platform.suite-session-generation.v1",
    "platformAcknowledgementKey": "ghrab.ludus.suite-session-seen.v1",
    "childStatusKey": "ghrab.ludus.suite-session-status.v1",
    "tabSeenKey": "ghrab.ludus.suite-session-tab-seen.v1",
    "ownership": {
      "generationKey": "platform-global-read-only-for-ludus",
      "platformAcknowledgementKey": "platform",
      "childStatusKey": "ludus",
      "tabSeenKey": "ludus"
    }
  },
  "sharedStateNotOwnedByLudus": [
    {
      "kind": "localStorage",
      "key": "ghrab.platform.suite-session-generation.v1",
      "owner": "GHRAB Platform",
      "ludusAccess": "read/listen-only"
    },
    {
      "kind": "localStorage",
      "key": "ghrab.platform.handoff.v2",
      "owner": "GHRAB Platform/Studio bridge",
      "ludusAccess": "through bridge contract only"
    },
    {
      "kind": "localStorage",
      "key": "ghrab.handoff.v1",
      "owner": "legacy Studio bridge",
      "ludusAccess": "legacy bridge compatibility only"
    },
    {
      "kind": "localStorage",
      "key": "ghrab.pilot.events.v2",
      "owner": "AI Studio",
      "ludusAccess": "legacy bridge event compatibility only"
    }
  ]
}
