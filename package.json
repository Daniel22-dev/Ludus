{
  "name": "ludus",
  "version": "1.16.23",
  "description": "LUDUS — dílna výukových her (builder + samostatné enginy)",
  "type": "module",
  "scripts": {
    "build": "LUDUS_MEDIA_PROFILE=unofficial node scripts/build.mjs",
    "test": "npm run validate:media && npm run build && node scripts/validate.mjs",
    "qa:technical": "node scripts/qa-technical.mjs",
    "qa:security": "node scripts/qa-security.mjs",
    "qa:pwa": "node scripts/qa-pwa.mjs",
    "qa:critical": "node scripts/qa-critical.mjs",
    "qa:visual": "node scripts/qa-visual.mjs",
    "qa:report": "node scripts/qa-report.mjs",
    "qa:approve": "node scripts/qa-approve.mjs",
    "qa:release": "node scripts/qa-release.mjs",
    "qa:combinatorial": "node scripts/qa-combinatorial.mjs",
    "test:reporter": "node scripts/test-error-reporter.mjs",
    "build:school-server": "npm run build:unofficial && node scripts/build-school-profile.mjs && npm run garp25:sw:school",
    "verify:platform": "node scripts/ghrab-platform-conformance.mjs",
    "postbuild": "node scripts/ghrab-platform-conformance.mjs && npm run garp25:sw",
    "qa:platform": "node scripts/ghrab-platform-conformance.mjs",
    "test:p2": "npm run build && npm run qa:platform",
    "qa:quality": "node scripts/qa-p3-quality.mjs",
    "qa:p3": "npm run verify:platform && npm run qa:quality && npm run qa:browser && npm run qa:reflow && npm run qa:axe && npm run qa:media",
    "test:p3": "npm run build && npm run qa:p3",
    "validate:media": "node scripts/validate-media-rights.mjs",
    "build:official": "npm run build:official-private",
    "qa:media": "node scripts/qa-media-provenance.mjs",
    "qa:browser": "node scripts/qa-p3-browser.mjs",
    "qa:axe": "node scripts/qa-p5-axe-runtime.mjs",
    "qa:reflow": "node scripts/qa-p5-runtime.mjs",
    "qa:p3:ci": "npm run verify:platform && npm run qa:quality && npm run qa:reflow && npm run qa:browser && AXE_REQUIRED=1 npm run qa:axe && npm run qa:media",
    "build:without-media": "npm run build:unofficial",
    "qa:a11y": "node scripts/qa-p5-runtime.mjs",
    "qa:p4": "npm run qa:p5",
    "qa:p4:ci": "npm run qa:p5:ci",
    "qa:p5": "npm run qa:lock && npm run build && npm run garp25:prep-static && npm run verify:platform && npm run qa:quality && npm run qa:browser && npm run qa:runtime && npm run qa:xss && npm run qa:pc01 && npm run qa:suite-session && npm run qa:media && npm run garp25:p5-certification-controls && node scripts/qa-p5-release.mjs && node scripts/qa-p5-acceptance.mjs",
    "qa:p5:ci": "npm run qa:lock && npm run build && npm run garp25:prep-static && npm run verify:platform && npm run qa:quality && npm run qa:browser && npm run qa:runtime && npm run qa:xss && npm run qa:pc01 && npm run qa:suite-session && npm run qa:media && npm run qa:axe && AXE_REQUIRED=1 npm run garp25:p5-certification-controls && AXE_REQUIRED=1 node scripts/qa-p5-release.mjs && node scripts/qa-p5-acceptance.mjs",
    "test:p5": "npm run qa:p5",
    "build:unofficial": "LUDUS_MEDIA_PROFILE=unofficial node scripts/build.mjs",
    "qa:runtime": "node scripts/qa-p5-runtime.mjs",
    "build:official-private": "LUDUS_MEDIA_PROFILE=official LUDUS_PRIVATE_MEDIA_ACK=1 node scripts/build.mjs",
    "qa:xss": "node scripts/qa-p5-xss-sinks.mjs",
    "qa:lock": "node scripts/qa-p5-lock.mjs",
    "pretest:reporter": "npm run build",
    "qa:garp": "node scripts/qa-garp-security.mjs",
    "qa:garp23": "node scripts/qa-garp23-security.mjs",
    "qa:garp23:critical": "node scripts/qa-garp23-critical.mjs",
    "qa:garp23:privacy": "node scripts/qa-garp23-privacy-lifecycle.mjs && node scripts/qa-suite-session.mjs",
    "qa:suite-session": "node scripts/qa-suite-session.mjs",
    "qa:pc01": "node scripts/qa-pc01-suite-session.mjs",
    "garp25:selftest": "node security/garp25/tools/selftest-garp251.mjs",
    "garp25:sw": "node security/garp25/tools/check-sw-security-freeze.mjs dist/sw.js dist security/security-critical-assets.json",
    "garp25:leaks": "node security/garp25/tools/scan-deployment-leaks.mjs dist",
    "garp25:sbom": "node scripts/generate-cyclonedx-sbom.mjs security/sbom/ludus-1.16.23.cdx.json",
    "garp25:sbom:check": "node scripts/generate-cyclonedx-sbom.mjs security/sbom/ludus-1.16.23.cdx.json --check",
    "garp25:ai-evidence": "node scripts/generate-ai-assurance-fingerprint.mjs security/evidence/ai-assurance-fingerprint.json",
    "garp25:ai-evidence:check": "node scripts/generate-ai-assurance-fingerprint.mjs security/evidence/ai-assurance-fingerprint.json --check",
    "garp25:source-scan": "node scripts/garp25-source-scan.mjs",
    "garp25:prep-static": "npm run garp25:selftest && npm run garp25:sbom:check && npm run garp25:sbom:verify && npm run garp25:ai-evidence:check && npm run garp25:ai-evidence:verify && npm run garp25:source-scan && npm run garp25:action-pins && npm run garp25:ai-resource && npm run garp25:logging-canary && npm run garp25:sw && npm run garp25:leaks && npm run garp25:ai-core-sync-patch",
    "garp25:action-pins": "node scripts/check-action-pins.mjs",
    "garp25:ai-resource": "node scripts/qa-garp25-ai-resource.mjs",
    "garp25:logging-canary": "node scripts/qa-garp25-logging-canary.mjs",
    "garp25:sw:school": "node security/garp25/tools/check-sw-security-freeze.mjs dist-school-server/sw.js dist-school-server security/security-critical-assets.json",
    "garp25:sbom:verify": "node scripts/verify-cyclonedx-sbom.mjs security/sbom/ludus-1.16.23.cdx.json",
    "garp25:sbom:deploy": "node scripts/generate-cyclonedx-sbom.mjs security/sbom/ludus-1.16.23-deployment.cdx.json --deploy",
    "garp25:sbom:deploy:check": "node scripts/generate-cyclonedx-sbom.mjs security/sbom/ludus-1.16.23-deployment.cdx.json --deploy --check",
    "garp25:p5-certification-controls": "node scripts/qa-garp25-p5-certification-controls.mjs",
    "garp25:ai-core-sync-patch": "node scripts/qa-garp25-ai-core-sync-patch.mjs",
    "garp25:ai-evidence:verify": "node security/garp25/tools/verify-ai-assurance-fingerprint.mjs security/evidence/ai-assurance-fingerprint.json security/ai-boundary-files.json ."
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "axe-core": "4.12.1",
    "jsdom": "26.1.0",
    "playwright": "1.61.1",
    "pngjs": "7.0.0"
  },
  "dependencies": {}
}
