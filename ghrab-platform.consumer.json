{
  "schema": "ghrab-platform-consumer-v1",
  "appId": "ludus",
  "appName": "LUDUS",
  "appVersion": "1.16.16",
  "platform": {
    "version": "1.1.0",
    "contract": "ghrab-platform-v1",
    "requiredRange": ">=1.1.0 <2.0.0",
    "compatibilityWindow": [
      "1.1.x",
      "1.2.x"
    ]
  },
  "brand": {
    "version": "1.0.0",
    "logo": "assets/brand/school-logo.png",
    "footerContract": "ghrab-footer-v1"
  },
  "theme": {
    "supported": [
      "light",
      "dark",
      "system"
    ],
    "default": "system",
    "systemFallback": "dark"
  },
  "storageMigration": {
    "id": "p2-storage-namespace-v1",
    "backup": "full",
    "mappings": [
      {
        "legacyPrefix": "ludus_",
        "canonicalPrefix": "ghrab.ludus."
      },
      {
        "legacyPrefix": "ludus.",
        "canonicalPrefix": "ghrab.ludus."
      }
    ]
  },
  "bridge": {
    "contract": "ghrab-studio-handoff-v2",
    "acceptsLegacy": "ghrab-handoff-v1",
    "maxBytes": 500000
  },
  "artifact": {
    "schema": "ghrab-artifact-envelope-v1",
    "checksum": "SHA-256",
    "exports": [],
    "imports": [
      "studio-material",
      "ludus-content"
    ],
    "acceptsLegacyJson": true,
    "nativeFormats": [
      "html",
      "json"
    ]
  },
  "cache": {
    "name": "ghrab-ludus-v1.16.16",
    "updateMessage": "GHRAB_SKIP_WAITING"
  },
  "html": {
    "exclude": [
      "engines/"
    ],
    "noFooter": [
      "engines/",
      "tests/"
    ]
  },
  "quality": {
    "schema": "ghrab-quality-consumer-v1",
    "accessibilityContract": "ghrab-a11y-v1",
    "performanceContract": "ghrab-performance-v1",
    "moduleContract": "ghrab-lazy-modules-v1",
    "requireBudget": true,
    "performanceBudget": {
      "distBytes": 4900000,
      "entryHtmlBytes": 310000,
      "entryCriticalBytes": 515000,
      "largestInlineScriptBytes": 270000,
      "precacheBytes": 1220000,
      "largestFileBytes": 1050000,
      "duplicateLargeBytes": 50000
    },
    "modules": {
      "required": [
        "runtime/ludus-engine-runtime.js",
        "content/engine-index.json"
      ],
      "contentPacks": [
        "content/engine-index.json"
      ]
    },
    "referenceProfile": {
      "cpuSlowdown": 4,
      "viewport": "1366x768",
      "memoryClassGb": 4,
      "viewportWidths": [
        1280,
        390,
        320
      ]
    },
    "stage": "P5",
    "a11yContract": "ghrab-a11y-v1",
    "media": {
      "contract": "ludus-media-rights-records-v1",
      "defaultProfile": "safe",
      "officialReleaseFailClosed": true
    },
    "requireRuntimeBudget": true,
    "runtimeBudget": {
      "maxDomNodes": 1000,
      "maxRenderReadyMs": 2500,
      "maxJsHeapUsedBytes": 8000000,
      "maxLayoutDurationMs": 1800,
      "maxTaskDurationMs": 2500
    },
    "finalRelease": true,
    "cleanInstallRequired": true,
    "a11yGate": "ghrab-p5-runtime-a11y-v2",
    "releaseGate": "ghrab-p5-release-v2",
    "runtimeAudit": {
      "scriptsExecuted": true,
      "transport": "local-http",
      "dialogStates": true,
      "viewports": [
        1280,
        390,
        320
      ]
    }
  },
  "performance": {
    "stage": "P5",
    "a11yGate": "ghrab-p5-accessibility-acceptance-v1",
    "releaseGate": "ghrab-p5-acceptance-v1",
    "finalRelease": false,
    "preProductionAccepted": true,
    "media": {
      "defaultProfile": "official",
      "canonicalModes": [
        "official",
        "unofficial"
      ],
      "legacyModeAliases": {
        "safe": "unofficial"
      }
    }
  }
}
