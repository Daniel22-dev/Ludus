{
  "schema": "ghrab-data-manifest-v1",
  "appId": "ludus",
  "appVersion": "1.16.18",
  "manifestVersion": 4,
  "dataCategories": [
    "settings",
    "application-content",
    "diagnostics",
    "ai-prompts-and-results"
  ],
  "privacy": {
    "studentContentMayOccur": true,
    "telemetryContainsContent": false,
    "diagnosticsContainContentByDefault": false,
    "pseudonymisationIsNotAnonymisation": true
  },
  "stores": [
    {
      "kind": "localStorage",
      "category": "application-data",
      "patterns": [
        "ghrab.ludus.*",
        "ludus_*",
        "ludus.*",
        "chronos_*",
        "jumanji_*",
        "hga_v2",
        "laughworks_save_v1",
        "kostka_osudu_save_v1",
        "relic_hunter_*",
        "hvezdni_rytiri_*"
      ],
      "sensitivity": "potentially-personal",
      "authority": "client",
      "clearOnEndWork": true,
      "purpose": "builder preferences plus legacy engine keys retained only as cleanup targets; engine player/progress writes are redirected to sessionStorage in 1.16.18"
    },
    {
      "kind": "sessionStorage",
      "category": "session-data",
      "patterns": [
        "ghrab.ludus.*",
        "ludus_*",
        "ludus.*",
        "ludusTeacherMode"
      ],
      "sensitivity": "confidential",
      "authority": "client",
      "clearOnEndWork": true,
      "purpose": "tab-scoped engine identity/progress and session UI state"
    },
    {
      "kind": "localStorage",
      "category": "credential",
      "patterns": [
        "ghrab.ludus.gemini_key",
        "ghrab.ludus.gemini_key_session"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "sessionStorage",
      "category": "credential",
      "patterns": [
        "ghrab.ludus.gemini_key",
        "ghrab.ludus.gemini_key_session"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "cacheStorage",
      "category": "application-cache",
      "patterns": [
        "ghrab-ludus-v*",
        "ludus*"
      ],
      "sensitivity": "non-content-cache",
      "authority": "client",
      "clearOnEndWork": false
    }
  ],
  "retention": {
    "defaultDays": 30,
    "sessionEndsOnLogout": true,
    "serverLogsDays": 30
  },
  "export": {
    "supported": true,
    "requiresExplicitUserAction": true,
    "includesSecrets": false,
    "envelopeSchema": "ghrab-artifact-envelope-v1",
    "artifactTypes": [],
    "nativeFormats": [
      "html",
      "json"
    ]
  },
  "deletion": {
    "supported": true,
    "clientVerified": true,
    "control": "LUDUSPrivacy.endWork()"
  },
  "sharedDevice": {
    "supported": true,
    "defaultInSchoolProfile": true,
    "control": "LUDUSPrivacy.endWork()",
    "isolation": "engine player identity/progress is tab/session scoped; legacy persistent engine keys are scrubbed before engine execution",
    "simultaneousTabs": "isolated by sessionStorage per browsing context"
  },
  "storageNamespace": {
    "schema": "ghrab-storage-namespace-v1",
    "prefix": "ghrab.ludus.",
    "migrationId": "p2-storage-namespace-v1",
    "backup": "full",
    "rollbackSupported": true
  },
  "import": {
    "supported": true,
    "artifactTypes": [
      "studio-material",
      "ludus-content"
    ],
    "acceptsLegacyJson": true,
    "checksumRequiredForEnvelope": true
  }
}
